# Application Configuration
APP_NAME="Ultimate ERP"
APP_ENV=production
APP_KEY=base64:your-app-key-here
APP_DEBUG=false
APP_URL=https://your-domain.com

# Database Configuration (MariaDB on Synology)
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=erp_db
DB_USERNAME=erp_user
DB_PASSWORD=your-secure-password

# Session & Cache Configuration
SESSION_DRIVER=redis
SESSION_LIFETIME=120
CACHE_DRIVER=redis
QUEUE_CONNECTION=redis

# Redis Configuration
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail Configuration
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=your-email@gmail.com
MAIL_FROM_NAME="${APP_NAME}"

# File Storage (Synology NAS volumes)
FILESYSTEM_DRIVER=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# OAuth Configuration (Laravel Passport)
PASSPORT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----
your-private-key-here
-----END RSA PRIVATE KEY-----"

PASSPORT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
your-public-key-here
-----END PUBLIC KEY-----"

# Mobile App Configuration
FCM_SERVER_KEY=your-fcm-server-key
MOBILE_API_VERSION=1.0.0
MOBILE_MIN_VERSION=1.0.0

# Security Configuration
BCRYPT_ROUNDS=12
SECURITY_HEADER_HSTS=true
SECURITY_HEADER_NOSNIFF=true
SECURITY_HEADER_FRAME_DENY=true
SECURITY_CSP_ENABLE=true

# Performance Configuration
OPTIMIZE_AUTOLOADER=true
CACHE_CONFIG=true
CACHE_ROUTES=true
CACHE_VIEWS=true

# Backup Configuration (untuk automated backup ke Synology)
BACKUP_DISK=nas_backup
BACKUP_MYSQL_HOST=${DB_HOST}
BACKUP_MYSQL_PORT=${DB_PORT}
BACKUP_MYSQL_DATABASE=${DB_DATABASE}
BACKUP_MYSQL_USERNAME=${DB_USERNAME}
BACKUP_MYSQL_PASSWORD=${DB_PASSWORD}

# Synology Specific
SYNOLOGY_NAS_IP=192.168.1.100
SYNOLOGY_SSH_USER=admin
SYNOLOGY_BACKUP_PATH=/volume1/backup/erp

# Additional Services
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

# Third-party Integrations
OPENAI_API_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=

# Google Services
GOOGLE_MAP_API_KEY=
GOOGLE_RECAPTCHA_KEY=
GOOGLE_RECAPTCHA_SECRET=

# SSL Certificate paths on Synology
SSL_CERT_PATH=/usr/local/etc/certificate/WebStation/your-domain.com/cert.pem
SSL_KEY_PATH=/usr/local/etc/certificate/WebStation/your-domain.com/privkey.pem
